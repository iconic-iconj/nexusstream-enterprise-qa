              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request without token is rejected\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-005 Verify authenticated user resource",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Authenticated request succeeds\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test(\"Response identifies current user\", () => pm.expect(b.email || (b.user && b.user.email)).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-006 SECURITY REGRESSION: regular user must not access admin logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/logs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "logs"
              ]
            },
            "description": "Expected security requirement: 403. The provided route implementation appears to authenticate but not enforce role=admin. This test may fail against current code; preserve the failure as evidence."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Regular user must be denied admin logs\", () => pm.response.to.have.status(403));",
                  "if (pm.response.code === 200) console.warn(\"POTENTIAL AUTHORIZATION DEFECT: route returned logs to a regular user.\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 \u2014 Orders and Idempotency",
      "item": [
