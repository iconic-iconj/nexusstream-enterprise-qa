        {
          "name": "TC-008/009 Product catalog contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Response contains data array\", () => pm.expect(b.data).to.be.an(\"array\"));",
                  "pm.test(\"Product fields have expected types\", () => { b.data.forEach(p => { pm.expect(p).to.have.property(\"id\"); pm.expect(p.name).to.be.a(\"string\"); pm.expect(Number(p.price)).to.be.finite; pm.expect(Number(p.stock)).to.be.finite; }); });"
