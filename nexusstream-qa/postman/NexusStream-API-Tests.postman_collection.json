      "item": [
        {
          "name": "TC-027 Health contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Health contract\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.status).to.eql(\"operational\"); pm.expect(b.timestamp).to.be.a(\"string\"); });"
                ]
              }
