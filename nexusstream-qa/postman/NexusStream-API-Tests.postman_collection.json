        {
          "name": "TC-014/028 Create order (valid stock required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Seeded SQLite product id=1 is Quantum Blade X1 at 2499.99 with initial stock 50. Verify current test DB before running; use an existing product ID and actual price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"quantity\": 1,\n      \"price\": 2499.99\n    }\n  ],\n  \"totalPrice\": 2499.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order creation returns success\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test(\"Order ID is returned\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.orderId).to.exist; });",
                  "if (b.orderId) pm.environment.set(\"last_order_id\", String(b.orderId));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-015 Reject order above stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"quantity\": 999999,\n      \"price\": 2499.99\n    }\n  ],\n  \"totalPrice\": 2499.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Insufficient stock is rejected\", () => pm.response.to.have.status(409));",
                  "const b=pm.response.json();",
                  "pm.test(\"Error explains stock rejection\", () => { pm.expect(b.success).to.eql(false); pm.expect(b.error).to.eql(\"Insufficient stock\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-030 Repeat order with same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Send this request twice without changing idempotency_key. Current API stores the key and returns the previous orderId when replayed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": 1,\n      \"quantity\": 1,\n      \"price\": 2499.99\n    }\n  ],\n  \"totalPrice\": 2499.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Idempotent replay returns successful order response\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test(\"Order ID is present\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.orderId).to.exist; });",
                  "const first=pm.environment.get(\"first_idempotent_order_id\");",
                  "if (first) pm.test(\"Replay returns the original order ID\", () => pm.expect(String(b.orderId)).to.eql(String(first)));",
                  "else if (b.orderId) pm.environment.set(\"first_idempotent_order_id\", String(b.orderId));"
                ]
              }
            }
          ]
        }
      ]
    },
