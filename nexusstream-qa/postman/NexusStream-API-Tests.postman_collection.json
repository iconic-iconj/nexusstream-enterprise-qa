        {
          "name": "TC-003 Login valid user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Login response contains token and user\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.token).to.be.a(\"string\"); pm.expect(b.user.email).to.eql(pm.environment.get(\"test_email\")); });",
                  "if (b.token) pm.environment.set(\"user_token\", b.token);",
                  "if (b.user && b.user.id) pm.environment.set(\"user_id\", String(b.user.id));"
                ]
              }
