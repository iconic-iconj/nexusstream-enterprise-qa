    {
      "name": "03 \u2014 Authentication and Authorization",
      "item": [
        {
          "name": "TC-005 Reject unauthenticated protected request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user",
              "host": [
                "{{base_url}}"
              ],
